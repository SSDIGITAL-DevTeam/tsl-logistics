# ── TSL API Backend ──────────────────────────────────────────────────────────
TSL_API_URL=https://api.tsllogistics.sg

# ── Site Configuration ────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://tsllogistics.sg

# ── Google Analytics 4 ───────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── Google Search Console (paste the content= value from verification meta tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=production
port=3000
