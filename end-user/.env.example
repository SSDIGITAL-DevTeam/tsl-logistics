# ── TSL API Backend ──────────────────────────────────────────────────────────
TSL_API_URL=https://api.tsllogistics.sg

# ── Site Configuration ────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://tsllogistics.sg

# ── Google Analytics 4 ───────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── Google Tag Manager ───────────────────────────────────────────────────────
# One container for the whole site. It must hold Google Ads conversion tags
# ONLY — no Google Tag, GA4 Configuration or GA4 Event tags (GTM offers to
# create one when a container is first opened; decline it). GA4 is loaded
# separately via NEXT_PUBLIC_GA_ID above; configuring it here as well would
# double-count every pageview and every lead.
# Leave empty to disable GTM entirely — see resolveGtmId() in app/layout.tsx.
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# ── Google Search Console (paste the content= value from verification meta tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=production
port=3000
