# Application
NODE_ENV=development
PORT=3000

# Database (MySQL)
DATABASE_URL=mysql://root:@localhost:3306/tsl_logistics

# JWT Secrets (use long random strings in production)
ACCESS_TOKEN_SECRET=change_me_access_secret_min_32_chars
REFRESH_TOKEN_SECRET=change_me_refresh_secret_min_32_chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Cookie (set to your root domain in production, e.g. .tsl-logistics.com)
COOKIE_DOMAIN=

# CORS origins (comma-separated, no spaces)
ORIGIN=http://localhost:3000,http://localhost:5173

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@tsl-logistics.com

# Lead notification recipient (fallback for sources not mapped below, e.g. general Contact page)
LEAD_NOTIFY_TO=admin@tsl-logistics.com

# Per-entity lead notification routing (based on the enquiry form's `source` field)
LEAD_NOTIFY_TSL_LOGISTICS=sales@tsllogistics.sg
LEAD_NOTIFY_TSL_MOVER=ops@tslmovers.sg
LEAD_NOTIFY_TSL_EXPRESS=ops@tslexpress.sg

# Password reset link (back-office URL)
RESET_LINK_URL=http://localhost:5173/reset-password

# Upload directory (relative to api-backend root)
UPLOAD_DIR=./uploads

# reCAPTCHA v3 secret (optional — leave empty to skip validation)
RECAPTCHA_SECRET=
